# ============================================================
#  Игра в Docker: одна система на один порт (APP_PORT=8080)
#  Скопируйте в .env и заполните свои значения.
# ============================================================

# Единственный публикуемый порт всего стека
APP_PORT=8080

# --- PostgreSQL (снаружи не публикуется!) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=game_db

# --- GitHub OAuth (те же значения, что в game-client/.env.local) ---
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-secret
NEXTAUTH_SECRET=generate-with: openssl rand -base64 32

# --- CORS (необязательно) ---
# Разрешённые источники для браузера (comma-separated).
# По умолчанию уже разрешены localhost:8080/3000 и 192.168.8.96:3000.
# После настройки туннеля добавьте его адрес или поставьте *:
# GAME_CORS_ALLOWED_ORIGINS=*

# Публичный адрес приложения.
# Пока без тунеля: http://localhost:8080
# После настройки тунеля замените на адрес тунеля,
# например: https://game.example.com
NEXTAUTH_URL=http://localhost:8080

# --- Администрирование игры (опционально) ---
ADMIN_PLAYER_IDS=
ADMIN_BOOTSTRAP_CODE=let-me-in